# ── Secrets — NEVER commit ──────────────────────────────
config/.env
config/.env.runtime
.env
.env.local
*.pem
*.key

# ── Logs (contain conversation data / PII) ──────────────
logs/
*.log

# ── Python generated ────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Virtual environments ────────────────────────────────
.venv/
venv/
env/

# ── OS / editor junk ────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Channel adapters & test UI (NOT deployed to AgentCore) ──
# These stay on disk for local testing (python channels/web/app.py) but are
# kept out of this deploy branch. The brain in agent/ is what AgentCore runs.
channels/
web_test_ui/
