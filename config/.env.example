# chatbot_web — Environment Configuration
# Copy this file to config/.env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8002
ENVIRONMENT=development          # development | uat | production

# ── Session Store ─────────────────────────────────────────────────────────────
# Options: memory (default, single-instance dev) | postgres | agentcore
SESSION_BACKEND=memory
SESSION_TTL_SECONDS=900          # 15 minutes

# Postgres (required when SESSION_BACKEND=postgres)
SESSION_DB_URL=postgresql://user:password@localhost:5432/chatbot_web

# AgentCore Memory (required when SESSION_BACKEND=agentcore)
# AGENTCORE_MEMORY_ENDPOINT=https://<memory-id>.memory.bedrock-agentcore.<region>.amazonaws.com
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# ── LLM (AWS Bedrock) ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ACTIVE_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── API Gateway Auth ──────────────────────────────────────────────────────────
# Token that Simcomm must send in the Authorization header.
# We generate this and share it with the Simcomm team.
WEB_API_TOKEN=

# ── Pre-Login Flow Config ─────────────────────────────────────────────────────
# Axis Direct portal deeplink (shown in Edit Profile flow)
AXIS_DIRECT_PORTAL_URL=https://login.axisdirect.in

# Axis Bank contact redirect (shown in Bank Query flow)
AXIS_BANK_CARE_NUMBER=1860 419 5555
AXIS_BANK_WEBSITE=https://www.axisbank.com
AXIS_BANK_BRANCH_LOCATOR=https://branch.axisbank.com/

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
